# === Supabase (lay tu Supabase Dashboard > Project Settings) ===
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Postgres connection string cho Drizzle.
# Supabase > Settings > Database > Connection string.
#
# TREN VERCEL: PHAI dung "Transaction pooler" (port 6543), KHONG dung "Direct
# connection". Direct connection (db.<ref>.supabase.co:5432) chi co IPv6, ma
# Vercel serverless chay IPv4 -> khong bao gio ket noi duoc.
DATABASE_URL=postgresql://postgres.xyzcompany:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Chay migration tu may local (drizzle-kit) thi dung Session pooler (port 5432):
# DATABASE_URL=postgresql://postgres.xyzcompany:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# === App ===
# Email admin dau tien (se duoc gan role=admin sau khi dang ky)
ADMIN_EMAIL=ban@example.com
# Secret ma hoa refresh token Gmail (tao chuoi ngau nhien 32+ ky tu)
GMAIL_TOKEN_ENCRYPTION_KEY=thay-bang-chuoi-ngau-nhien-32-ky-tu

# === Gmail API (giu nguyen logic cu, chi doi redirect URI) ===
GMAIL_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=xxx
GMAIL_OAUTH_REDIRECT_URI=https://<domain-vercel-cua-ban>/api/gmail/oauth/callback
GMAIL_SENDER_EMAIL=ban@gmail.com

# === Ably (chat realtime) ===
# CHI dat bien server-side nay. KHONG tao VITE_ABLY_API_KEY: moi bien VITE_*
# deu bi nhung vao bundle JS cong khai, lo key = nguoi khac toan quyen app Ably.
# Client lay token ngan han qua /api/ably/token.
ABLY_API_KEY=xxx:yyy

# === Vercel (khong can tao tay, Vercel tu co PORT/NODE_ENV) ===
# NODE_ENV=production
